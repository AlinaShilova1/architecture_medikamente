@startuml DFD_Level1_Process1_Reception
title DFD Уровень 1: Процесс "Запись пациента и ведение мед.карты" (As-Is)

rectangle "Внешние сущности" {
  (Пациент) as patient
  (Мед. специалист) as doctor
  (Сотрудник ресепшена) as reception
}

rectangle "Процессы" {
  (1.1\nПрием входящего обращения) as p1
  (1.2\nСоздание/обновление карты пациента) as p2
  (1.3\nЗапись на прием) as p3
  (1.4\nПрием пациента. Заполнение мед. карты) as p4
}

database "Хранилища данных" {
  (Файлы Excel\n"Журнал записей") as store_journal
  (Общий файловый диск\nСканы/фото мед.документов) as store_scans
  (Файлы Excel\n"Мед. карты") as store_medcards
  (Active Directory\nУчетные записи) as store_ad
}

store_ad --> p1 : Аутентификация
patient --> p1 : Звонок/Визит
reception --> p1 : Ввод данных от пациента
p1 --> p2 : Запрос на создание/поиск карты
p2 --> store_medcards : Поиск по ФИО/телефону
store_medcards --> p2 : Данные пациента (если есть)
p2 --> store_medcards : Запись новых/измененных ПДн
p1 --> p3 : Данные для записи
p3 --> store_journal : Внесение записи (ФИО, врач, время)
store_journal --> reception : Расписание на экране
p3 --> patient : Подтверждение записи (устно/на бумажке)
patient --> p4 : Визит в клинику
doctor --> p4 : Осмотр, диагноз, назначения
p4 --> store_scans : Сохранение сканов заключений
p4 --> store_medcards : Запись текстовых данных о визите

note right of store_scans #pink
 **КРИТИЧЕСКИЙ РИСК**
 Хранилище общее. Нет контроля
 доступа к мед.данным.
end note
note right of store_medcards #pink
 **КРИТИЧЕСКИЙ РИСК**
 Файлы Excel доступны всем
 в сети. ПДн+медицина вместе.
end note

@enduml
