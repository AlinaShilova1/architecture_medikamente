@startuml DFD_ToBe_Process1_Reception_Corrected
title DFD To-Be: Процесс "Запись пациента и ведение мед.карты"

rectangle "Внешние сущности" {
  (Пациент) as patient
  (Мед. специалист) as doctor
  (Сотрудник ресепшена) as reception
}

rectangle "Процессы" {
  (1.1\nПрием входящего обращения\nПортал/ЛК/Телефон) as p1
  (1.2\nСоздание/обновление карты пациента\nс тегированием данных) as p2
  (1.3\nЗапись на прием\nв защищенное расписание) as p3
  (1.4\nПрием пациента. Заполнение\nмед. карты с контролем доступа) as p4
}

database "Хранилища данных" {
  (Защищенная БД ПДн пациентов) as db_pii
  (Защищенное хранилище\nмедицинских документов) as db_med
  (Расписание с маскированными\nданными) as store_schedule
  (SIEM / Централизованный аудит) as siem
  (Сервис управления доступом\n"IAM/ABAC") as iam
}

' === ПОТОКИ ДАННЫХ ===
' 1. Прием обращения
patient --> p1 : Запрос на запись (TLS)
p1 --> iam : Аутентификация пациента/сессии
iam --> p1 : Подтверждение
p1 --> p2 : Передача ПДн для обработки

' 2. Обработка ПДн
p2 --> db_pii : Поиск/создание записи пациента\nс тегами: confidential:restricted, regulation:152-fz
db_pii --> p2 : ID пациента (внутренний идентификатор)
p2 --> siem : Лог события создания/изменения ПДн

' 3. Запись на прием
p2 --> p3 : ID пациента + пожелания по записи
p3 --> store_schedule : Создание записи с маскированным ФИО\n(Напр: Ив*** Ив***, 12:00, терапевт)
store_schedule --> p3 : Подтверждение
p3 --> patient : Подтверждение записи (в ЛК/SMS)

' 4. Медицинский прием
doctor --> p4 : Запрос мед. карты пациента для приема
p4 --> iam : Проверка политики ABAC\n(роль=врач, филиал=совпадает, пациент=назначен)
iam --> p4 : Разрешение
p4 --> db_pii : Получение ПДн (требуемые поля)
db_pii --> p4 : ПДн пациента
p4 --> db_med : Запись диагноза, назначений, результатов\nс тегами: confidential:restricted, regulation:medical_secret 
p4 --> siem : Лог доступа к мед. карте и создания записи

' 5. Работа ресепшена
reception --> p3 : Запрос на просмотр/изменение расписания
p3 --> iam : Проверка роли "ресепшен"
iam --> p3 : Разрешение
p3 --> reception : Отображение расписания с маскированными данными пациентов

note right of p2
  **Новый функционал:**
  - Автоматическое тегирование
  - Возврат только внутреннего ID
  - Принцип минимизации данных
end note

note right of siem
  **Централизованный аудит:**
  - Все операции с ПДн
  - Все доступы к мед.данным
  - Алерты на аномалии
end note

@enduml
