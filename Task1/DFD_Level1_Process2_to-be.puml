@startuml DFD_ToBe_Process2_Payments_Corrected
title DFD To-Be: Процесс "Прием платежей и учет"

rectangle "Внешние сущности" {
  (Пациент) as patient
  (Кассир) as cashier
  (Бухгалтер) as accountant
}

rectangle "Процессы" {
  (2.1\nФормирование защищенного счета\nс маскированием данных) as p1
  (2.2\nПрием оплаты\nчерез защищенный канал) as p2
  (2.3\nАвтоматическое отражение\nв бух.системе через API) as p3
  (2.4\nСверка и отчетность\nна основе обезличенных данных) as p4
}

database "Хранилища данных" {
  (БД счетов и платежей\nс маскированием) as db_payments
  (1С:Бухгалтерия сервер\nв изолированном сегменте) as db_1c
  (Платежный провайдер\n"Банк/Эквайринг") as bank
  (SIEM) as siem
  (IAM) as iam
}

' === ПОТОКИ ДАННЫХ ===
' 1. Формирование счета
patient --> p1 : Запрос счета на услугу
p1 --> iam : Проверка прав пациента на услугу
iam --> p1 : Разрешение
p1 --> db_payments : Создание счета (ID пациента, сумма, услуга)\nТег: confidential:confidentialТ]
db_payments --> p1 : Номер счета (токен)
p1 --> patient : Счет с номером (без полных ПДн)

' 2. Прием оплаты
patient --> p2 : Оплата счета
p2 --> bank : Перенаправление на защищенную страницу оплаты
bank --> p2 : Подтверждение оплаты (webhook)
p2 --> db_payments : Обновление статуса счета "Оплачен"
p2 --> siem : Лог финансовой транзакции

' 3. Автоматическая интеграция с 1С
db_payments --> p3 : Событие "Счет оплачен" (ID счета, сумма)
p3 --> db_1c : Создание бухгалтерской проводки\n(без ПДн, по коду договора)
db_1c --> p3 : Подтверждение
p3 --> siem : Лог успешной синхронизации

' 4. Работа кассира (только для наличных)
cashier --> p2 : Внесение данных о наличной оплате
p2 --> iam : Проверка роли кассир + MFA
iam --> p2 : Разрешение
p2 --> cashier : Интерфейс с маскированными данными пациента
cashier --> p2 : Подтверждение приема наличных
p2 --> db_payments : Запись операции 

' 5. Отчетность
accountant --> p4 : Запрос отчетов
p4 --> iam : Проверка роли бухгалтер
iam --> p4 : Разрешение
p4 --> db_1c : Получение агрегированных финансовых данных
db_1c --> p4 : Данные для отчетности (P&L, обороты)
p4 --> accountant : Отчеты без ПДн пациентов

note left of p3
  **Исключение ручного переноса:**
  - Автоматическая синхронизация
  - Нет доступа кассира к полным ПДн
  - Снижение риска ошибок и утечек
end note

note right of bank
  **Соответствие PCI DSS:**
  - Платежные реквизиты
    обрабатываются провайдером
  - В наших системах только
    токены и статусы
end note

@enduml
