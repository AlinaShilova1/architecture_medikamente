@startuml DFD_Level1_Process3_Inventory
title DFD Уровень 1: Процесс "Учет ТМЦ" (As-Is)

rectangle "Внешние сущности" {
  (Мед. специалист) as doctor
  (Кладовщик) as storekeeper
  (Поставщик) as supplier
}

rectangle "Процессы" {
  (3.1\nФормирование заявки на ТМЦ) as p1
  (3.2\nПриемка и оприходование) as p2
  (3.3\nОтпуск со склада) as p3
  (3.4\nИнвентаризация и заказ) as p4
}

database "Хранилища данных" {
  (1С:Торговля и склад\n"Файловый режим") as store_1c_trade
  (Excel-файлы\n"Заявки") as store_requests
  (Физический склад) as physical_store
}

doctor --> p1 : Запрос на медикаменты/материалы
p1 --> store_requests : Сохранение заявки (ФИО врача, наименование)
store_requests --> storekeeper : Уведомление о новой заявке

supplier --> p2 : Поставка товара, накладные
storekeeper --> p2 : Сверка с заказом
p2 --> store_1c_trade : Оприходование ТМЦ (приходная накладная)
p2 --> physical_store : Размещение на складе

storekeeper --> p3 : Получение заявки
store_requests --> p3 : Данные заявки
p3 --> store_1c_trade : Списание ТМЦ (расходная накладная)
p3 --> physical_store : Выдача товара
p3 --> doctor : Передача ТМЦ

storekeeper --> p4 : Проведение инвентаризации
physical_store --> p4 : Фактические остатки
store_1c_trade --> p4 : Учетные остатки
p4 --> store_1c_trade : Корректировка остатков
p4 --> p1 : Сигнал для нового заказа (при низком остатке)

note right of store_1c_trade #yellow
 **ПРОБЛЕМА ИЗОЛИРОВАННОСТИ**
 Данные по ТМЦ есть, но они не
 связаны с мед.картами (кто, какое
 лечение получил). Потеря аналитики.
end note

@enduml
