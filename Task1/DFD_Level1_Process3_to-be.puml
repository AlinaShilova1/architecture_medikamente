@startuml DFD_ToBe_Process3_Inventory_Corrected
title DFD To-Be: Процесс "Учет ТМЦ"

rectangle "Внешние сущности" {
  (Мед. специалист) as doctor
  (Кладовщик) as storekeeper
  (Бизнес-аналитик) as analyst
}

rectangle "Процессы" {
  (3.1\nФормирование заявки на ТМЦ\nс привязкой к пациенту) as p1
  (3.2\nПриемка и оприходование\nс контролем целостности) as p2
  (3.3\nОтпуск со склада\nс проверкой авторизации) as p3
  (3.4\nПодготовка обезличенных данных\nдля аналитики и ML) as p4
}

database "Хранилища данных" {
  (1С:Торговля и склад, сервер\nс шифрованием) as db_1c_trade
  (База заявок с тегами) as db_requests
  (Data Lake с обезличенными\nданными) as lake_datalake
  (Физический склад\nс системой контроля доступа) as physical_store
  (IAM) as iam
}

' === ПОТОКИ ДАННЫХ ===
' 1. Формирование заявки
doctor --> p1 : Запрос на медикаменты/материалы
p1 --> iam : Проверка: врач авторизован для пациента?
iam --> p1 : Разрешение
p1 --> db_requests : Создание заявки (ID врача, ID пациента, ТМЦ)\nТег: confidential:internal
db_requests --> p1 : Код заявки
p1 --> doctor : Подтверждение

' 2. Приемка
storekeeper --> p2 : Сканирование поставки
p2 --> db_1c_trade : Оприходование ТМЦ по накладной
db_1c_trade --> p2 : Подтверждение
p2 --> physical_store : Размещение на складе с маркировкой

' 3. Отпуск со склада
storekeeper --> p3 : Ввод кода заявки
p3 --> db_requests : Получение данных заявки
db_requests --> p3 : Данные  (ID ТМЦ, количество, ID врача)
p3 --> iam : Проверка прав кладовщика на выдачу
iam --> p3 : Разрешение
p3 --> db_1c_trade : Списание ТМЦ по заявке
db_1c_trade --> p3 : Подтверждение
p3 --> physical_store : Выдача ТМЦ
p3 --> doctor : Уведомление о готовности к выдаче

' 4. Подготовка данных для аналитики
db_requests --> p4 : Поток данных о выданных ТМЦ
db_1c_trade --> p4 : Данные о движении ТМЦ (приход/расход)
p4 --> p4 : Процесс обезличивания
p4 --> lake_datalake : Запись обезличенных данных
lake_datalake --> analyst : Доступ через BI-инструменты

note right of p4
  Data Lake для аналитики:
  - Полностью обезличенные данные
  - Сохранение аналитической ценности
  - Без риска нарушения 152-ФЗ
  - Готовность для ML/AI
end note

note left of db_requests
  Улучшение As-Is:
  - Заявки привязаны к пациенту
  - Полная прослеживаемость
  - Контроль доступа на каждом этапе
end note

@enduml
